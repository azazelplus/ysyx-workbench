# nemu模拟器的主Makefile. 编译构建的层级:(它最终编译出riscv32-nemu-interpreter可执行文件)


#########################################################
# 运行本makefile的run需要提供参数:  
# IMG(要运行的二进制镜像文件路径.)
#########################################################



# $(NEMU_HOME)/Makefile(nemu主Makefile)
#   ├── [include] $(NEMU_HOME)/include/config/auto.conf          [配置变量]  
#   ├── [include] $(NEMU_HOME)/include/config/auto.conf.cmd      [配置命令]
#   ├── [include] $(NEMU_HOME)/src/filelist.mk                   [顶层源文件列表]
#   │             └──(被find命令找到的所有子目录的 filelist.mk)
#   │                       ├── [include] $(NEMU_HOME)/src/engine/filelist.mk    [引擎模块源文件]
#   │                       ├── [include] $(NEMU_HOME)/src/device/filelist.mk    [设备模块源文件]
#   │                       ├── [include] $(NEMU_HOME)/src/isa/filelist.mk       [ISA架构源文件]
#   │                       └── [include] $(NEMU_HOME)/src/utils/filelist.mk     [工具模块源文件]
#   ├── [include] $(NEMU_HOME)/scripts/config.mk                 [Kconfig 配置规则]
#   └── [include] $(NEMU_HOME)/scripts/native.mk                 [本地构建规则]
#                 ├── [include] $(NEMU_HOME)/scripts/build.mk              [核心编译规则]
#                 └── [include] $(NEMU_HOME)/tools/difftest.mk             [差分测试规则]

# NEMU主Makefile包含关系:

# $(NEMU_HOME)/Makefile(nemu主Makefile)
#   ├── include $(NEMU_HOME)/include/config/auto.conf          [配置变量]  
#   ├── include $(NEMU_HOME)/include/config/auto.conf.cmd      [配置命令]
#   ├── include $(NEMU_HOME)/src/filelist.mk                   [顶层源文件列表]
#   │             └──(被find命令找到的所有子目录的 filelist.mk)
#   │                       ├── include $(NEMU_HOME)/src/engine/filelist.mk    [引擎模块源文件]
#   │                       ├── include $(NEMU_HOME)/src/device/filelist.mk    [设备模块源文件]
#   │                       ├── include $(NEMU_HOME)/src/isa/filelist.mk       [ISA架构源文件]
#   │                       └── include $(NEMU_HOME)/src/utils/filelist.mk     [工具模块源文件]
#   ├── include $(NEMU_HOME)/scripts/config.mk                 [Kconfig 配置规则]
#   └── include $(NEMU_HOME)/scripts/native.mk                 [本地构建规则]
#                 ├── include $(NEMU_HOME)/scripts/build.mk              [核心编译规则]
#                 └── include $(NEMU_HOME)/tools/difftest.mk             [差分测试规则]

# make run调用nemu主Makefile作用: 编译 NEMU 模拟器本身
# 产物：nemu/build/riscv32-nemu-interpreter（可执行文件）


################################################################################
# 需要传递参数: 
# ARGS
# 来源: 本Makefile认为由上层提供. 实际上是
# 用途: 在最后 `[运行] $(NEMU_HOME)/Makefile` 时, 给可执行文件 `riscv32-nemu-interpreter` 传递的命令行参数.
# NEMUFLAGS: 在nemu.mk定义. 是运行 `$(NEMU_HOME)/Makefile` 的make run时, 要传给`$(NEMU_HOME)/Makefile` 内变量ARGS的参数.

################################################################################





# =============Sanity check====================
# 检查环境变量 NEMU_HOME 是否设置+是否有正确的项目结构:`$(NEMU_HOME)/src/nemu-main.c` 
# 如果上述路径不存在, wildcard返回空字符串. 进入报错.
ifeq ($(wildcard $(NEMU_HOME)/src/nemu-main.c),)
  $(error NEMU_HOME=$(NEMU_HOME) is not a NEMU repo)
endif

# =================Include variables and rules generated by menuconfig===================
# 加载auto.conf和 auto.conf.cmd(Kconfig编译后生成. 用来被包含到Makefile中) 
# `-include`: 如果文件不存在, 则忽略该指令继续执行. 安全加载机制.
-include $(NEMU_HOME)/include/config/auto.conf
-include $(NEMU_HOME)/include/config/auto.conf.cmd

remove_quote = $(patsubst "%",%,$(1))

# Extract variabls from menuconfig
# 我们当前的项目配置下, GUEST_ISA=riscv32, ENGINE=interpreter, 从而NAME=riscv32-nemu-interpreter.
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
ENGINE ?= $(call remove_quote,$(CONFIG_ENGINE))
NAME    = $(GUEST_ISA)-nemu-$(ENGINE)

# Include all filelist.mk to merge file lists
# filelist.mk包含了要编译的源文件. 分开维护.
FILELIST_MK = $(shell find -L ./src -name "filelist.mk")
include $(FILELIST_MK)

# Filter out directories and files in blacklist to obtain the final set of source files

# DIRS-BLACKLIST-y是不参与编译的目录集合.
DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)

# 不参与编译的源文件集合.
SRCS-BLACKLIST-y += $(SRCS-BLACKLIST) $(shell find -L $(DIRS-BLACKLIST-y) -name "*.c")

# SRCS-y 是参与编译的源文件的候选集合.
SRCS-y += $(shell find -L $(DIRS-y) -name "*.c")

# 最终参与编译的源文件集合SRCS = 候选集合SRCS-y - 黑名单集合SRCS-BLACKLIST-y
SRCS = $(filter-out $(SRCS-BLACKLIST-y),$(SRCS-y))



# =====================Extract compiler and options from menuconfig=========================
# (call remove_quote,$(arg)) 用来去掉变量值中的引号.
# CFLAGS_TRACE用来存放和trace有关的编译配置选项. 包括目前实现的itrace, mtrace.
# -D是gcc的定义宏选项, `-Dxxx=...`等同于在C代码中开头添加了一行`#define xxx=...`
CC = $(call remove_quote,$(CONFIG_CC))
CFLAGS_BUILD += $(call remove_quote,$(CONFIG_CC_OPT))
CFLAGS_BUILD += $(if $(CONFIG_CC_LTO),-flto,)
CFLAGS_BUILD += $(if $(CONFIG_CC_DEBUG),-Og -ggdb3,)
CFLAGS_BUILD += $(if $(CONFIG_CC_ASAN),-fsanitize=address,)
# 这两行给gcc添加两个宏CONFIG_ITRACE_COND_EXPR和CONFIG_MTRACE_COND_EXPR, 值分别是用户在Kconfig中配置的条件表达式去掉`""`. 之所以不直接用Kconfig工具生成的autoconf.h, 是因为这两个宏需要去掉`""`
CFLAGS_TRACE += -DCONFIG_ITRACE_COND_EXPR=$(if $(CONFIG_ITRACE_COND),$(call remove_quote,$(CONFIG_ITRACE_COND)),true) 
CFLAGS_TRACE += -DCONFIG_MTRACE_COND_EXPR=$(if $(CONFIG_MTRACE_COND),$(call remove_quote,$(CONFIG_MTRACE_COND)),true)
CFLAGS_TRACE += -DCONFIG_DTRACE_COND_EXPR=$(if $(CONFIG_DTRACE_COND),$(call remove_quote,$(CONFIG_DTRACE_COND)),true)
CFLAGS  += $(CFLAGS_BUILD) $(CFLAGS_TRACE) -D__GUEST_ISA__=$(GUEST_ISA)
LDFLAGS += $(CFLAGS_BUILD)

# Include rules for menuconfig
# `config.mk`是 Kconfig 编译后生成的.
include $(NEMU_HOME)/scripts/config.mk

ifdef CONFIG_TARGET_AM
include $(AM_HOME)/Makefile
LINKAGE += $(ARCHIVES)
else
# Include rules to build NEMU
# `native.mk`包含了不同平台的编译规则.
include $(NEMU_HOME)/scripts/native.mk
endif
